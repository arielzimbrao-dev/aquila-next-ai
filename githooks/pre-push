#!/bin/sh
# aquila-next-ai: runs the "pre-push" gates from docs/ai/aquila.json (failures and totals only).
# The project is two folders up (.aquila/githooks/), also when it lives in a subfolder of the repository.
cd "$(dirname "$0")/../.." && exec node node_modules/aquila-next-ai/bin/aquila.mjs gate pre-push
